{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RoadWatcher",
  "version": "0.1.0",
  "identifier": "dev.roadwatcher.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "RoadWatcher Evidence Workstation",
        "width": 1440,
        "height": 950,
        "minWidth": 1180,
        "minHeight": 760
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.ico"],
    "license": "GPL-3.0-or-later",
    "category": "Utility"
  }
}
