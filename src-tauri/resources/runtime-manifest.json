      "resourcePath": "sidecars/roadwatcher-cv",
      "requiredFiles": [
        "pyproject.toml",
        "uv.lock",
        "README.md",
        "src/roadwatcher_cv/__init__.py",
        "src/roadwatcher_cv/cli.py",
        "src/roadwatcher_cv/scanner.py"
