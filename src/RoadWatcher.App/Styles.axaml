<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Fluent controls provide the component language. These few semantic tokens
       keep RoadWatcher's map/video workbench legible in every system theme. -->
  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="AppBackground">#111316</SolidColorBrush>
          <SolidColorBrush x:Key="PanelBackground">#1A1D21</SolidColorBrush>
          <SolidColorBrush x:Key="PanelRaised">#23272C</SolidColorBrush>
          <SolidColorBrush x:Key="PanelBorder">#343A40</SolidColorBrush>
          <SolidColorBrush x:Key="TextPrimary">#F4F4F6</SolidColorBrush>
          <SolidColorBrush x:Key="TextSecondary">#B0B8C1</SolidColorBrush>
          <SolidColorBrush x:Key="AccentTeal">#45D6C5</SolidColorBrush>
          <SolidColorBrush x:Key="AccentAmber">#F4C44E</SolidColorBrush>
          <SolidColorBrush x:Key="Danger">#E97878</SolidColorBrush>
          <SolidColorBrush x:Key="NavigationBackground">#171A1E</SolidColorBrush>
          <SolidColorBrush x:Key="PaneHeaderBackground">#20242A</SolidColorBrush>
          <SolidColorBrush x:Key="PaneDropBackground">#244843</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="AppBackground">#F5F6F8</SolidColorBrush>
          <SolidColorBrush x:Key="PanelBackground">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="PanelRaised">#F0F2F5</SolidColorBrush>
          <SolidColorBrush x:Key="PanelBorder">#D2D8E0</SolidColorBrush>
          <SolidColorBrush x:Key="TextPrimary">#20242A</SolidColorBrush>
          <SolidColorBrush x:Key="TextSecondary">#5C6570</SolidColorBrush>
          <SolidColorBrush x:Key="AccentTeal">#007F73</SolidColorBrush>
          <SolidColorBrush x:Key="AccentAmber">#9B6500</SolidColorBrush>
          <SolidColorBrush x:Key="Danger">#B42318</SolidColorBrush>
          <SolidColorBrush x:Key="NavigationBackground">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="PaneHeaderBackground">#F8F9FB</SolidColorBrush>
          <SolidColorBrush x:Key="PaneDropBackground">#D9F2ED</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource AppBackground}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
  </Style>

  <Style Selector="Border.navigation-rail">
    <Setter Property="Background" Value="{DynamicResource NavigationBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
    <Setter Property="BorderThickness" Value="0,0,1,0" />
  </Style>

  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Border.pane-header">
    <Setter Property="Background" Value="{DynamicResource PaneHeaderBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource PanelBorder}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <Style Selector="Border.pane-drag-handle">
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="Cursor" Value="SizeAll" />
  </Style>

  <Style Selector="Border.pane-drag-handle:pointerover">
    <Setter Property="Background" Value="{DynamicResource PanelRaised}" />
  </Style>

  <Style Selector="Border.workbench-pane.pane-drop-target">
    <Setter Property="Background" Value="{DynamicResource PaneDropBackground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentTeal}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="Grid.workbench-pane.pane-drop-target">
    <Setter Property="Background" Value="{DynamicResource PaneDropBackground}" />
  </Style>

  <Style Selector="GridSplitter.workbench-splitter">
    <Setter Property="Background" Value="{DynamicResource PanelBorder}" />
  </Style>

  <Style Selector="GridSplitter.workbench-splitter:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentTeal}" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>

  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="7" />
  </Style>

  <Style Selector="Button.nav">
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10" />
  </Style>

  <Style Selector="Button.nav.selected">
    <Setter Property="Background" Value="{DynamicResource PanelRaised}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTeal}" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentAmber}" />
    <Setter Property="Foreground" Value="#1A1200" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>
</Styles>
