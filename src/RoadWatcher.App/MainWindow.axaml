<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:RoadWatcher.App.Controls"
        xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        xmlns:mapsui="clr-namespace:Mapsui.UI.Avalonia;assembly=Mapsui.UI.Avalonia"
        x:Class="RoadWatcher.App.MainWindow"
        mc:Ignorable="d"
        Title="RoadWatcher — Evidence Workbench"
        Width="1152"
        Height="820"
        MinWidth="1000"
        MinHeight="700"
        FontSize="11"
        WindowStartupLocation="CenterScreen">
  <Grid ColumnDefinitions="110,*,3,235,3,235" RowDefinitions="53,*,42,304">
    <!-- Navigation -->
    <Border Grid.RowSpan="4" Grid.Column="0" Background="#081A22" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="53,*">
        <TextBlock Margin="14,0" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Text="RoadWatcher" />
        <StackPanel Grid.Row="1" Spacing="7" Margin="6,10">
          <Button Classes="nav selected" Focusable="False" IsHitTestVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <materialIcons:MaterialIcon Kind="PlayCircleOutline" Width="20" Height="20" />
              <TextBlock VerticalAlignment="Center" Text="Workbench" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Click="OnCreateProjectClicked" ToolTip.Tip="Create a .roadwatcher project">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <materialIcons:MaterialIcon Kind="FolderPlusOutline" Width="20" Height="20" />
              <TextBlock VerticalAlignment="Center" Text="New" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Click="OnOpenProjectClicked" ToolTip.Tip="Open a .roadwatcher project">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <materialIcons:MaterialIcon Kind="FolderOpenOutline" Width="20" Height="20" />
              <TextBlock VerticalAlignment="Center" Text="Open" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Command="{Binding SaveProjectCommand}" IsEnabled="{Binding HasOpenProject}" ToolTip.Tip="Save the current project">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <materialIcons:MaterialIcon Kind="ContentSaveOutline" Width="20" Height="20" />
              <TextBlock VerticalAlignment="Center" Text="Save" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Command="{Binding CloseProjectCommand}" IsEnabled="{Binding HasOpenProject}" ToolTip.Tip="Close the current project">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <materialIcons:MaterialIcon Kind="FolderRemoveOutline" Width="20" Height="20" />
              <TextBlock VerticalAlignment="Center" Text="Close" />
            </StackPanel>
          </Button>
          <Button Classes="nav" Command="{Binding ExportEvidenceCommand}" IsEnabled="{Binding HasOpenProject}" ToolTip.Tip="Export saved incidents" AutomationProperties.Name="Export evidence package">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <materialIcons:MaterialIcon Kind="ExportVariant" Width="20" Height="20" />
              <TextBlock VerticalAlignment="Center" Text="Exports" />
            </StackPanel>
          </Button>
          <Button Classes="nav"
                  Command="{Binding PrepareProxiesCommand}"
                  IsEnabled="{Binding CanPrepareProxies}"
                  ToolTip.Tip="Use supplied .LRV previews or generate bounded FFmpeg review proxies"
                  AutomationProperties.Name="Prepare review previews">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <materialIcons:MaterialIcon Kind="MovieOutline" Width="20" Height="20" />
              <TextBlock VerticalAlignment="Center" Text="Previews" />
            </StackPanel>
          </Button>
          <Button Classes="nav"
                  Command="{Binding ToggleJobsDrawerCommand}"
                  ToolTip.Tip="Open FFmpeg jobs">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <materialIcons:MaterialIcon Kind="ProgressWrench" Width="20" Height="20" />
              <TextBlock VerticalAlignment="Center" Text="Jobs" />
            </StackPanel>
          </Button>
          <Button Classes="nav"
                  Command="{Binding OpenSettingsCommand}"
                  ToolTip.Tip="App settings and local service status">
            <StackPanel Orientation="Horizontal" Spacing="12">
              <materialIcons:MaterialIcon Kind="CogOutline" Width="20" Height="20" />
              <TextBlock VerticalAlignment="Center" Text="Settings" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Header -->
    <Border Grid.Column="1" Grid.ColumnSpan="5" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="*,Auto,8,Auto,8,Auto,16,Auto" Margin="14,0,18,0">
        <StackPanel VerticalAlignment="Center" Spacing="3">
          <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding ProjectTitle}" />
          <TextBlock Classes="muted" FontSize="10" Text="{Binding LoadedMediaName}" />
        </StackPanel>
        <CheckBox Grid.Column="1"
                  VerticalAlignment="Center"
                  IsChecked="{Binding CopySourcesIntoProject}"
                  IsEnabled="{Binding HasOpenProject}"
                  Content="Copy sources"
                  ToolTip.Tip="Store imported media and GPX under this project"
                  AutomationProperties.Name="Copy imported sources into project" />
        <Button Grid.Column="3"
                VerticalAlignment="Center"
                Click="OnImportRideClicked"
                IsEnabled="{Binding HasOpenProject}"
                AutomationProperties.Name="Import ride sources">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <materialIcons:MaterialIcon Kind="FolderPlusOutline" Width="18" Height="18" />
            <TextBlock Text="Import ride" />
          </StackPanel>
        </Button>
        <Button Grid.Column="5" VerticalAlignment="Center" Click="OnRelinkSourceClicked" IsVisible="{Binding HasMissingSources}">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <materialIcons:MaterialIcon Kind="LinkVariant" Width="18" Height="18" />
            <TextBlock Text="Relink missing" />
          </StackPanel>
        </Button>
        <StackPanel Grid.Column="7" VerticalAlignment="Center" Spacing="3">
          <TextBlock Foreground="{StaticResource AccentTeal}" Text="{Binding ProjectStateText}" />
          <TextBlock Classes="muted" FontSize="10" Text="{Binding MissingSourceCount, StringFormat={}{0} missing source(s)}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Video -->
    <Border Grid.Row="1" Grid.Column="1" Background="#020609" ClipToBounds="True">
      <Grid RowDefinitions="Auto,*">
        <Border Padding="13,8" Background="#D90A1A20" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,0,1" IsVisible="{Binding ShowTelemetryOverlay}">
          <Grid ColumnDefinitions="Auto,20,Auto,20,Auto,20,*">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <materialIcons:MaterialIcon Kind="Speedometer" Width="17" Height="17" />
              <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding SpeedKmhText}" />
              <TextBlock VerticalAlignment="Bottom" Margin="-3,0,0,2" FontSize="9" Text="km/h" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7">
              <materialIcons:MaterialIcon Kind="AxisArrow" Width="17" Height="17" />
              <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding AccelerationText}" />
              <TextBlock VerticalAlignment="Bottom" Margin="-3,0,0,2" FontSize="9" Text="m/s²" />
            </StackPanel>
            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="7">
              <materialIcons:MaterialIcon Kind="ClockOutline" Width="17" Height="17" />
              <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding TelemetryClockText}" />
            </StackPanel>
            <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="7">
              <materialIcons:MaterialIcon Kind="MapMarkerOutline" Width="17" Height="17" />
              <StackPanel Spacing="0">
                <TextBlock FontWeight="SemiBold" Text="{Binding RoadLocationText}" />
                <TextBlock Classes="muted" FontFamily="Consolas" FontSize="9" Text="{Binding CoordinateText}" />
              </StackPanel>
            </StackPanel>
          </Grid>
        </Border>
        <controls:EmbeddedVideoView x:Name="VideoSurface"
                                    Grid.Row="1"
                                    IsVisible="{Binding ShowPlaybackSurface}"
                                    MediaPlayer="{Binding MediaPlayer}" />
        <Border x:Name="MarkingFrameSurface"
                Grid.Row="1"
                IsVisible="{Binding IsMarkingFrameActive}"
                Background="#020609"
                ClipToBounds="True">
          <Grid>
            <Canvas x:Name="MarkingCanvas"
                    Background="#020609"
                    PointerPressed="OnMarkingCanvasPointerPressed"
                    PointerMoved="OnMarkingCanvasPointerMoved"
                    PointerReleased="OnMarkingCanvasPointerReleased">
              <Image x:Name="MarkingFrameImage"
                     Width="{Binding #MarkingCanvas.Bounds.Width}"
                     Height="{Binding #MarkingCanvas.Bounds.Height}"
                     Stretch="Uniform" />
              <Border x:Name="MarkingSelectionBorder"
                      IsVisible="False"
                      Background="#38FFAD18"
                      BorderBrush="{StaticResource AccentAmber}"
                      BorderThickness="2"
                      CornerRadius="2" />
            </Canvas>
            <Border Margin="12"
                    Padding="9,6"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="#D90A1A20"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="4"
                    IsHitTestVisible="False">
              <StackPanel Spacing="2">
                <TextBlock FontSize="11" FontWeight="SemiBold" Text="Marking frame" />
                <TextBlock Classes="muted" FontSize="10" Text="Drag a vehicle or plate • source-direct capture" />
              </StackPanel>
            </Border>
            <Button HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="12"
                    Padding="9,5"
                    Click="OnCancelMarkingClicked"
                    ToolTip.Tip="Discard this marking frame">
              <TextBlock Text="Cancel marking" />
            </Button>
          </Grid>
        </Border>
        <Border Grid.Row="1" IsVisible="{Binding ShowEmptyState}" Background="#061217">
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
            <TextBlock HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Text="No video loaded" />
            <TextBlock HorizontalAlignment="Center" Classes="muted" Text="Create or open a project, then import ride sources." />
          </StackPanel>
        </Border>
      </Grid>
    </Border>

    <!-- Player controls -->
    <Border Grid.Row="2" Grid.Column="1" Classes="panel">
      <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto,Auto,Auto,Auto" Margin="9,0">
        <Button Grid.Column="0" Classes="icon" Command="{Binding TogglePlaybackCommand}" IsEnabled="{Binding CanUsePlaybackControls}" ToolTip.Tip="{Binding PlayLabel}" AutomationProperties.Name="{Binding PlayLabel}">
          <materialIcons:MaterialIcon Kind="{Binding PlayIcon}" Width="23" Height="23" />
        </Button>
        <Button Grid.Column="1" Classes="icon" Command="{Binding SeekBackCommand}" IsEnabled="{Binding CanUsePlaybackControls}" ToolTip.Tip="Back 10 seconds">
          <materialIcons:MaterialIcon Kind="Replay" Width="20" Height="20" />
        </Button>
        <Button Grid.Column="2" Classes="icon" Command="{Binding SeekForwardCommand}" IsEnabled="{Binding CanUsePlaybackControls}" ToolTip.Tip="Forward 10 seconds">
          <materialIcons:MaterialIcon Kind="FastForward10" Width="20" Height="20" />
        </Button>
        <TextBlock Grid.Column="3" Margin="8,0,8,0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="10" Text="{Binding CurrentTimeText}" ToolTip.Tip="Project time" />
        <TextBlock Grid.Column="4" Margin="0,0,12,0" VerticalAlignment="Center" Classes="muted" FontFamily="Consolas" FontSize="9" Text="{Binding SourceTimeText}" />
        <Slider x:Name="PlayerProgressSlider"
                Grid.Column="5"
                Margin="0,0,14,0"
                Minimum="0"
                Maximum="{Binding MaximumSeconds}"
                Value="{Binding CurrentSeconds, Mode=TwoWay}"
                IsEnabled="{Binding CanUsePlaybackControls}"
                PointerEntered="OnPlayerProgressPointerEntered"
                PointerMoved="OnPlayerProgressPointerMoved"
                PointerExited="OnPlayerProgressPointerExited"
                ToolTip.Tip="Hover briefly for a frame preview; drag to seek"
                AutomationProperties.Name="Project timeline position" />
        <Popup x:Name="PlayerProgressPreviewPopup" Placement="Top" IsLightDismissEnabled="False">
          <Border Padding="6" Background="#0A1C23" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="4" IsHitTestVisible="False">
            <StackPanel Spacing="4">
              <Image x:Name="PlayerProgressPreviewImage" Width="192" Height="108" Stretch="Uniform" IsVisible="False" />
              <TextBlock x:Name="PlayerProgressPreviewStatus" MaxWidth="220" FontSize="9" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Popup>
        <Grid Grid.Column="6" Margin="0,0,8,0" VerticalAlignment="Center" ColumnDefinitions="Auto,108" IsEnabled="{Binding CanUsePlaybackControls}">
          <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" FontFamily="Consolas" FontSize="10" Text="{Binding PlaybackRateText}" />
          <Slider Grid.Column="1"
                  Minimum="{Binding MinimumPlaybackRate}"
                  Maximum="{Binding MaximumPlaybackRate}"
                  TickFrequency="{Binding PlaybackRateStep}"
                  IsSnapToTickEnabled="True"
                  Value="{Binding PlaybackRate, Mode=TwoWay}"
                  ToolTip.Tip="Playback speed from 0.5× to 5×"
                  AutomationProperties.Name="Playback speed from 0.5× to 5×" />
        </Grid>
        <CheckBox Grid.Column="7"
                  Margin="0,0,9,0"
                  VerticalAlignment="Center"
                  IsEnabled="{Binding HasLoadedMedia}"
                  IsChecked="{Binding IsMarkingModeEnabled, Mode=TwoWay}"
                  Checked="OnMarkingModeChecked"
                  Unchecked="OnMarkingModeUnchecked"
                  ToolTip.Tip="Freeze an original-source frame, then drag to mark a vehicle or plate"
                  AutomationProperties.Name="Marking mode">
          <TextBlock FontSize="10" Text="Marking mode" />
        </CheckBox>
        <Button Grid.Column="8" Classes="icon" Command="{Binding CaptureFrameCommand}" IsEnabled="{Binding CanUsePlaybackControls}" ToolTip.Tip="Capture screenshot" AutomationProperties.Name="Capture current frame">
          <materialIcons:MaterialIcon Kind="CameraOutline" Width="20" Height="20" />
        </Button>
        <Button Grid.Column="9" Classes="icon" Click="OnCropFrameClicked" IsEnabled="{Binding CanUsePlaybackControls}" ToolTip.Tip="Crop current frame" AutomationProperties.Name="Crop current frame">
          <materialIcons:MaterialIcon Kind="Crop" Width="20" Height="20" />
        </Button>
      </Grid>
    </Border>

    <!-- Context dock -->
    <GridSplitter Grid.Row="1" Grid.RowSpan="3" Grid.Column="2" Width="4" Background="#18343D" ResizeDirection="Columns" />
    <Border Grid.Row="1" Grid.RowSpan="2" Grid.Column="3" Classes="panel">
      <Grid RowDefinitions="50,*,Auto">
        <Grid Margin="15,0" ColumnDefinitions="*,Auto">
          <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Context" />
          <ComboBox x:Name="MapStyleSelector"
                    Grid.Column="1"
                    Width="88"
                    VerticalAlignment="Center"
                    SelectedIndex="0"
                    SelectionChanged="OnMapStyleSelectionChanged"
                    ToolTip.Tip="Change the Context map style"
                    AutomationProperties.Name="Context map style">
            <ComboBoxItem Tag="Night" Content="Night" />
            <ComboBoxItem Tag="Day" Content="Day" />
            <ComboBoxItem Tag="Satellite" Content="Satellite" />
            <ComboBoxItem Tag="OpenStreetMap" Content="OSM" />
          </ComboBox>
        </Grid>
        <Border Grid.Row="1" Margin="10,0" CornerRadius="6" ClipToBounds="True" Background="#0B222B">
          <Grid>
            <mapsui:MapControl x:Name="ContextMap" />
            <Border x:Name="RoadContextMapPopup"
                    Width="242"
                    Margin="10"
                    Padding="8"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Background="#0A1C23"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="4"
                    IsVisible="False">
              <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock x:Name="RoadContextMapPopupTitle" FontSize="10" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <Button Grid.Column="1" Classes="icon" Click="OnRoadContextMapPopupClosed" ToolTip.Tip="Close road context details">
                    <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" />
                  </Button>
                </Grid>
                <TextBlock x:Name="RoadContextMapPopupDetail" Classes="muted" FontSize="9" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Border x:Name="GpxStopPreviewCard"
                    Width="250"
                    Margin="10"
                    Padding="8"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Background="#0A1C23"
                    BorderBrush="{StaticResource PanelBorder}"
                    BorderThickness="1"
                    CornerRadius="4"
                    IsVisible="False">
              <StackPanel Spacing="4">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock VerticalAlignment="Center" FontSize="10" FontWeight="SemiBold" Text="GPX stop preview" />
                  <Button Grid.Column="1"
                          Classes="icon"
                          Click="OnGpxStopPreviewClosed"
                          ToolTip.Tip="Close GPX stop preview"
                          AutomationProperties.Name="Close GPX stop preview">
                    <materialIcons:MaterialIcon Kind="Close" Width="16" Height="16" />
                  </Button>
                </Grid>
                <Image x:Name="GpxStopPreviewImage" Width="232" Height="130" Stretch="Uniform" IsVisible="False" />
                <TextBlock x:Name="GpxStopPreviewGpxTime" FontFamily="Consolas" FontSize="8" TextWrapping="Wrap" />
                <TextBlock x:Name="GpxStopPreviewProjectTime" FontFamily="Consolas" FontSize="9" TextWrapping="Wrap" />
                <TextBlock x:Name="GpxStopPreviewVideoTime" FontFamily="Consolas" FontSize="9" TextWrapping="Wrap" />
                <TextBlock x:Name="GpxStopPreviewStatus" Classes="muted" FontSize="9" TextWrapping="Wrap" />
                <Button x:Name="GpxStopPreviewJumpButton"
                        Click="OnGpxStopPreviewJumpClicked"
                        IsEnabled="False"
                        Content="Jump to frame"
                        ToolTip.Tip="Pause and seek to this stop's resolved video frame"
                        AutomationProperties.Name="Jump to GPX stop frame" />
              </StackPanel>
            </Border>
          </Grid>
        </Border>
        <StackPanel Grid.Row="2" Margin="16,12,16,16" Spacing="10">
          <Button IsEnabled="{Binding HasGpx}" Content="GPX synchronization…" AutomationProperties.Name="GPX synchronization">
            <Button.Flyout>
              <Flyout Closed="OnGpxSynchronizationFlyoutClosed">
                <Border Width="320" Padding="14" Background="{StaticResource PanelBackground}" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="6">
                  <StackPanel Spacing="7">
                    <TextBlock FontWeight="SemiBold" Text="GPX synchronization" />
                    <TextBlock Classes="muted" FontSize="10" Text="Whole-route shift (seconds)" />
                    <Grid ColumnDefinitions="*,Auto,Auto" IsEnabled="{Binding IsGpxSynchronizationEditingEnabled}">
                      <NumericUpDown Minimum="-86400"
                                     Maximum="86400"
                                     Increment="0.1"
                                     FormatString="0.000"
                                     Value="{Binding GpxOffsetSeconds}"
                                     AutomationProperties.Name="GPX offset seconds" />
                      <Button Grid.Column="1" Margin="6,0,0,0" Command="{Binding ApplyGpxOffsetCommand}" Content="Apply" AutomationProperties.Name="Apply GPX offset" />
                      <Button Grid.Column="2" Margin="6,0,0,0" Command="{Binding CancelGpxPreviewCommand}" Content="Cancel" AutomationProperties.Name="Cancel GPX synchronization preview" />
                    </Grid>
                    <TextBlock Classes="muted" FontSize="10" Text="GPX time at current playhead" />
                    <TextBox FontSize="10" Text="{Binding GpxAnchorTimeText}" AutomationProperties.Name="GPX anchor timestamp" />
                    <Grid ColumnDefinitions="*,*" IsEnabled="{Binding IsGpxSynchronizationEditingEnabled}">
                      <Button Margin="0,0,3,0" Command="{Binding SetFirstGpxAnchorCommand}" Content="Set first" AutomationProperties.Name="Set first GPX anchor" />
                      <Button Grid.Column="1" Margin="3,0,0,0" Command="{Binding SetSecondGpxAnchorCommand}" Content="Set second" AutomationProperties.Name="Set second GPX anchor" />
                    </Grid>
                    <Button IsEnabled="{Binding IsGpxSynchronizationEditingEnabled}" Command="{Binding ClearGpxDriftCommand}" Content="Clear drift correction" AutomationProperties.Name="Clear GPX drift correction" />
                    <TextBlock Classes="muted" FontSize="10" TextWrapping="Wrap" Text="{Binding GpxSyncStatusText}" />
                    <Separator Margin="0,3" />
                    <TextBlock FontWeight="SemiBold" Text="Exact time guide" />
                    <TextBlock Classes="muted" FontSize="9" TextWrapping="Wrap" Text="{Binding CameraClockReferenceText}" />
                    <TextBox FontFamily="Consolas"
                             FontSize="10"
                             Text="{Binding ExactTimelineTimeText}"
                             Watermark="2026-07-16 12:34:56.789 +00:00"
                             ToolTip.Tip="An explicit UTC offset is required; plot only compares clocks and never seeks playback"
                             AutomationProperties.Name="Exact timeline timestamp" />
                    <Grid ColumnDefinitions="*,*">
                      <Button Margin="0,0,3,0" Command="{Binding PlotExactTimelineGuideCommand}" Content="Plot guides" AutomationProperties.Name="Plot exact time guides" />
                      <Button Grid.Column="1" Margin="3,0,0,0" Command="{Binding ClearExactTimelineGuideCommand}" Content="Clear guides" AutomationProperties.Name="Clear exact time guides" />
                    </Grid>
                    <TextBlock Classes="muted" FontSize="9" TextWrapping="Wrap" Text="{Binding ExactTimelineGuideStatusText}" />
                  </StackPanel>
                </Border>
              </Flyout>
            </Button.Flyout>
          </Button>
          <Border Padding="9" Background="#0D2630" BorderBrush="#21414A" BorderThickness="1" CornerRadius="5">
            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Road context" />
                <Button Grid.Column="1"
                        Padding="8,3"
                        Command="{Binding LoadRoadContextCommand}"
                        IsEnabled="{Binding CanLoadRoadContext}"
                        Content="Load / refresh"
                        ToolTip.Tip="Fetch advisory road context for the aligned GPX route"
                        AutomationProperties.Name="Load road context" />
              </Grid>
              <TextBlock Classes="muted"
                         FontSize="9"
                         TextWrapping="Wrap"
                         Text="Reference only • verify video, signage, and local bylaws." />
              <WrapPanel ItemWidth="102" ItemHeight="23">
                <CheckBox IsChecked="{Binding ShowRoadControls}" Content="Stop controls" AutomationProperties.Name="Show road stop controls" />
                <CheckBox IsChecked="{Binding ShowTrafficSignals}" Content="Signals" AutomationProperties.Name="Show traffic signals" />
                <CheckBox IsChecked="{Binding ShowCyclingFacilities}" Content="Bike facilities" AutomationProperties.Name="Show bike facilities" />
                <CheckBox IsChecked="{Binding ShowParkingRestrictions}" Content="No parking" AutomationProperties.Name="Show no-parking restrictions" />
                <CheckBox IsChecked="{Binding ShowTrafficDirection}" Content="Direction" AutomationProperties.Name="Show traffic direction" />
                <CheckBox IsChecked="{Binding ShowTemporaryRestrictions}" Content="Dated closures" AutomationProperties.Name="Show dated road restrictions" />
              </WrapPanel>
              <TextBlock Classes="muted" FontSize="9" TextWrapping="Wrap" Text="{Binding RoadContextStatus}" />
              <CheckBox IsChecked="{Binding IncludeRoadContextInExport}"
                        IsEnabled="{Binding HasRoadContext}"
                        FontSize="9"
                        Content="Include non-evidence snapshot in export"
                        AutomationProperties.Name="Include road context snapshot in export" />
            </StackPanel>
          </Border>
          <TextBlock FontWeight="SemiBold" Text="Overlay Layers" />
          <CheckBox IsChecked="{Binding IsTelemetryOverlayVisible}"
                    IsEnabled="{Binding HasLoadedMedia}"
                    AutomationProperties.Name="Show telemetry overlay">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <materialIcons:MaterialIcon Kind="Bike" Width="18" Height="18" />
              <TextBlock Text="Telemetry" />
            </StackPanel>
          </CheckBox>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Inspector -->
    <GridSplitter Grid.Row="1" Grid.RowSpan="3" Grid.Column="4" Width="4" Background="#18343D" ResizeDirection="Columns" />
    <Border Grid.Row="1" Grid.RowSpan="3" Grid.Column="5" Classes="panel">
      <Grid RowDefinitions="50,*,Auto">
        <Grid Margin="14,0">
          <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="Incident inspector" />
        </Grid>
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" IsEnabled="{Binding HasIncidentDraft}">
          <StackPanel Margin="14,0,14,14" Spacing="8">
            <TextBlock Classes="muted" Text="Category" />
            <ComboBox ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding SelectedCategory}"
                      AutomationProperties.Name="Incident category" />

            <TextBlock Margin="0,8,0,0" Classes="muted" Text="Time window" />
            <Grid ColumnDefinitions="*,28,*">
              <TextBox Text="{Binding IncidentStartText}" AutomationProperties.Name="Incident project start" />
              <materialIcons:MaterialIcon Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Kind="ArrowRight" Width="17" Height="17" />
              <TextBox Grid.Column="2" Text="{Binding IncidentEndText}" AutomationProperties.Name="Incident project end" />
            </Grid>
            <TextBlock Classes="muted" FontSize="11" Text="{Binding IncidentDurationText}" />

            <TextBlock Margin="0,8,0,0" Classes="muted" Text="Location" />
            <TextBox Watermark="Intersection (optional)"
                     Text="{Binding Intersection}"
                     AutomationProperties.Name="Incident intersection" />
            <TextBox MinHeight="48"
                     Watermark="Address (optional)"
                     TextWrapping="Wrap"
                     Text="{Binding Address}"
                     AutomationProperties.Name="Incident address" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Classes="muted" FontSize="11" Text="{Binding CoordinateText}" />
              <CheckBox Grid.Column="1"
                        IsChecked="{Binding IsLocationConfirmed}"
                        Content="Confirmed"
                        AutomationProperties.Name="Confirm incident location" />
            </Grid>
            <Button Command="{Binding SuggestLocationCommand}"
                    Content="Suggest address online"
                    AutomationProperties.Name="Suggest incident address online" />
            <TextBlock Classes="muted"
                       FontSize="10"
                       TextWrapping="Wrap"
                       Text="{Binding LocationResolutionStatus}" />

            <TextBlock Margin="0,8,0,0" Classes="muted" Text="Vehicle plate" />
            <Grid ColumnDefinitions="*,66">
              <TextBox Text="{Binding PlateNumber}" AutomationProperties.Name="Vehicle plate" />
              <ComboBox Grid.Column="1"
                        ItemsSource="{Binding Provinces}"
                        SelectedItem="{Binding SelectedProvince}"
                        AutomationProperties.Name="Vehicle province" />
            </Grid>

            <TextBlock Margin="0,8,0,0" Classes="muted" Text="Vehicle colour" />
            <ComboBox ItemsSource="{Binding VehicleColors}"
                      SelectedItem="{Binding VehicleColor}"
                      AutomationProperties.Name="Vehicle colour" />

            <TextBlock Margin="0,8,0,0" Classes="muted" Text="Confidence" />
            <Grid ColumnDefinitions="62,*" RowDefinitions="32,32">
              <TextBlock VerticalAlignment="Center" Text="Plate" />
              <ComboBox Grid.Column="1"
                        ItemsSource="{Binding ConfidenceLevels}"
                        SelectedItem="{Binding PlateConfidence}"
                        AutomationProperties.Name="Plate confidence" />
              <TextBlock Grid.Row="1" VerticalAlignment="Center" Text="Event" />
              <ComboBox Grid.Row="1"
                        Grid.Column="1"
                        ItemsSource="{Binding ConfidenceLevels}"
                        SelectedItem="{Binding EventConfidence}"
                        AutomationProperties.Name="Event confidence" />
            </Grid>
            <CheckBox IsChecked="{Binding AreVehicleValuesConfirmed}"
                      Content="Vehicle values confirmed"
                      AutomationProperties.Name="Confirm vehicle values" />

            <TextBlock Margin="0,8,0,0" Classes="muted" Text="Notes" />
            <TextBox MinHeight="88"
                     MaxLength="500"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     Text="{Binding Notes}"
                     AutomationProperties.Name="Incident notes" />
            <TextBlock HorizontalAlignment="Right" Classes="muted" FontSize="10" Text="{Binding NotesCharacterCount}" />

            <TextBlock Classes="muted" Text="Tags" />
            <TextBox Watermark="Comma-separated tags…"
                     Text="{Binding TagsText}"
                     AutomationProperties.Name="Incident tags" />
            <Grid Margin="0,8,0,0" ColumnDefinitions="*,Auto">
              <TextBlock Classes="muted" Text="Attachments" />
              <TextBlock Grid.Column="1" Classes="muted" Text="{Binding AttachmentCount}" />
            </Grid>
            <Grid ColumnDefinitions="*,*">
              <Button Margin="0,0,4,0" Command="{Binding CaptureFrameCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <materialIcons:MaterialIcon Kind="CameraOutline" Width="17" Height="17" />
                  <TextBlock Text="Capture frame" />
                </StackPanel>
              </Button>
              <Button Grid.Column="1" Margin="4,0,0,0" Click="OnCropFrameClicked">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <materialIcons:MaterialIcon Kind="Crop" Width="17" Height="17" />
                  <TextBlock Text="Crop latest" />
                </StackPanel>
              </Button>
            </Grid>
            <TextBlock Classes="muted" FontSize="10" TextWrapping="Wrap" Text="{Binding RecognitionStatus}" />
            <TextBlock Margin="0,8,0,0" Classes="muted" Text="Latest export" />
            <TextBlock Classes="muted" FontSize="10" TextWrapping="Wrap" Text="{Binding LastExportPath}" />
          </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="2" Margin="14,8,14,14" Spacing="8">
          <Button Classes="primary" Command="{Binding MarkIncidentCommand}" IsEnabled="{Binding CanUsePlaybackControls}" HorizontalContentAlignment="Center" AutomationProperties.Name="Mark incident">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <materialIcons:MaterialIcon Kind="FlagOutline" Width="19" Height="19" />
              <TextBlock Text="Mark incident" />
            </StackPanel>
          </Button>
          <Button Command="{Binding SaveIncidentCommand}"
                  IsEnabled="{Binding HasIncidentDraft}"
                  HorizontalContentAlignment="Center"
                  Content="{Binding SaveIncidentButtonText}"
                  AutomationProperties.Name="Save or update incident" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Timeline -->
    <Border Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="3" Classes="panel">
      <Grid RowDefinitions="42,*,29">
        <Grid Margin="14,0" ColumnDefinitions="Auto,*,Auto">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
            <TextBlock FontWeight="SemiBold" Text="Timeline" />
            <Button Padding="8,4" IsEnabled="{Binding HasLoadedMedia}" Click="OnTimelineFitClicked" Content="Fit" ToolTip.Tip="Fit the complete ride" AutomationProperties.Name="Fit complete timeline" />
            <Button Padding="8,4" IsEnabled="{Binding HasLoadedMedia}" Click="OnTimelineZoomOutClicked" Content="−" ToolTip.Tip="Zoom out" AutomationProperties.Name="Zoom timeline out" />
            <Button Padding="8,4" IsEnabled="{Binding HasLoadedMedia}" Click="OnTimelineZoomInClicked" Content="+" ToolTip.Tip="Zoom in" AutomationProperties.Name="Zoom timeline in" />
            <RadioButton GroupName="TimelineEditMode" IsEnabled="{Binding HasLoadedMedia}" IsChecked="True" Checked="OnTimelineReorderModeChecked" Content="Reorder" ToolTip.Tip="Drag clips to change their order" AutomationProperties.Name="Reorder timeline clips" />
            <RadioButton GroupName="TimelineEditMode" IsEnabled="{Binding HasLoadedMedia}" Checked="OnTimelinePositionModeChecked" Content="Position" ToolTip.Tip="Drag clips freely to create or adjust gaps" AutomationProperties.Name="Position timeline clips" />
            <Button Padding="7,4" Command="{Binding UndoTimelineCommand}" IsEnabled="{Binding CanUndoTimeline}" Content="Undo" AutomationProperties.Name="Undo timeline edit" />
            <Button Padding="7,4" Command="{Binding RedoTimelineCommand}" IsEnabled="{Binding CanRedoTimeline}" Content="Redo" AutomationProperties.Name="Redo timeline edit" />
          </StackPanel>
          <TextBlock Grid.Column="2" VerticalAlignment="Center" Classes="muted" Text="{Binding TimelineSummaryText}" />
        </Grid>
        <controls:VirtualTimelineControl x:Name="TimelineSurface"
                                         Grid.Row="1"
                                         DurationSeconds="{Binding TimelineDisplayDurationSeconds}"
                                         MinimumSeconds="{Binding TimelineDisplayStartSeconds}"
                                         PositionSeconds="{Binding CurrentSeconds}"
                                         Blocks="{Binding TimelineBlocks}"
                                         Incidents="{Binding IncidentMarkers}"
                                         HasGpx="{Binding HasGpx}"
                                         GpxCoverageStartSeconds="{Binding GpxCoverageStartSeconds}"
                                         GpxCoverageEndSeconds="{Binding GpxCoverageEndSeconds}"
                                         GpxAnchors="{Binding GpxTimelineAnchors}"
                                         GpxSpeedSegments="{Binding GpxTimelineSpeedSegments}"
                                         GpxSpeedSamples="{Binding GpxTimelineSpeedSamples}"
                                         GpxPresentationOffsetSeconds="{Binding GpxTimelineSpeedPresentationOffsetSeconds}"
                                         GpxStops="{Binding GpxTimelineStops}"
                                         ExactTimeGuides="{Binding ExactTimelineGuideMarkers}"
                                         HasSelectedIncident="{Binding HasSelectedIncident}"
                                         SelectedIncidentStartSeconds="{Binding SelectedIncidentStartSeconds}"
                                         SelectedIncidentEndSeconds="{Binding SelectedIncidentEndSeconds}"
                                         ToolTip.Tip="Wheel jogs video time • Shift+wheel zooms • horizontal scroll pans the timeline without moving the cursor • visual GPX workspace extends around media • drag the GPX route or anchors to preview sync • Alt+Arrow nudges nearest GPX anchor"
                                         AutomationProperties.Name="Interactive project timeline" />

        <Grid Grid.Row="2" Margin="14,8" ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <StackPanel Orientation="Horizontal"
                        Spacing="10"
                        IsVisible="{Binding HasGpx}"
                        ToolTip.Tip="Fixed GPX speed scale in km/h: red at 0–1, then orange/yellow/green through 50+ • a stop requires ≤1 km/h for at least 3 seconds">
              <TextBlock Classes="muted" FontSize="9" Text="Speed (km/h)" />
              <TextBlock Foreground="#D94A4A" FontSize="9" Text="━ 0–1" />
              <TextBlock Foreground="#F28E3A" FontSize="9" Text="━ 10" />
              <TextBlock Foreground="#F1C84B" FontSize="9" Text="━ 20" />
              <TextBlock Foreground="#8ACB57" FontSize="9" Text="━ 30" />
              <TextBlock Foreground="#24A75D" FontSize="9" Text="━ 50+" />
              <TextBlock Foreground="#D85CFF" FontSize="9" Text="● stop" />
            </StackPanel>
            <TextBlock Classes="muted" FontSize="9" Text="◇ incident" />
            <TextBlock Foreground="{StaticResource AccentAmber}" FontSize="9" Text="▰ selected" />
          </StackPanel>
          <TextBlock Grid.Column="1" Classes="muted" FontSize="10" Text="{Binding StatusText}" />
        </Grid>
      </Grid>
    </Border>

    <!-- Global FFmpeg process drawer. It is deliberately outside the workbench
         panes so job state stays available while media controls are busy. -->
    <Border Grid.Row="0"
            Grid.RowSpan="4"
            Grid.Column="1"
            Grid.ColumnSpan="5"
            Width="372"
            HorizontalAlignment="Right"
            Background="#F20B222B"
            BorderBrush="{StaticResource PanelBorder}"
            BorderThickness="1,0,0,0"
            IsVisible="{Binding IsJobsDrawerOpen}">
      <Grid RowDefinitions="53,Auto,*,Auto">
        <Grid Margin="14,0" ColumnDefinitions="*,Auto,8,Auto">
          <StackPanel VerticalAlignment="Center" Spacing="2">
            <TextBlock FontSize="13" FontWeight="SemiBold" Text="FFmpeg jobs" />
            <TextBlock Classes="muted" FontSize="10" Text="Two encoders run globally; queued work starts automatically." />
          </StackPanel>
          <Button Grid.Column="1" VerticalAlignment="Center" Command="{Binding CancelAllFfmpegJobsCommand}" Content="Cancel all" />
          <Button Grid.Column="3" Classes="icon" VerticalAlignment="Center" Command="{Binding ToggleJobsDrawerCommand}">
            <materialIcons:MaterialIcon Kind="Close" Width="18" Height="18" />
          </Button>
        </Grid>
        <Grid Grid.Row="1" Margin="14,0,14,10" ColumnDefinitions="*,Auto">
          <TextBlock Classes="muted" Text="{Binding ActiveFfmpegJobCount, StringFormat={}{0} running}" />
          <TextBlock Grid.Column="1" Classes="muted" Text="{Binding QueuedFfmpegJobCount, StringFormat={}{0} queued}" />
        </Grid>
        <ScrollViewer Grid.Row="2" Margin="14,0">
          <ItemsControl ItemsSource="{Binding FfmpegJobsSnapshot}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,0,0,8" Padding="10" Background="#C6081A22" BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="4">
                  <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                      <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                      <TextBlock Classes="muted" FontSize="10" Text="{Binding SourceName}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="4">
                      <TextBlock Classes="muted" FontSize="10" Text="{Binding State}" />
                      <Button Padding="6,2"
                              Command="{Binding DataContext.CancelFfmpegJobCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                              CommandParameter="{Binding}"
                              Content="Cancel" />
                    </StackPanel>
                    <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Minimum="0" Maximum="1" Value="{Binding Progress}" />
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="0,5,0,0" Classes="muted" FontSize="9" Text="{Binding Error}" TextWrapping="Wrap" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <TextBlock Grid.Row="3" Margin="14,10,14,14" Classes="muted" FontSize="9" TextWrapping="Wrap" Text="Cancelled work deletes its temporary derivative. Canonical evidence files are never replaced." />
      </Grid>
    </Border>

    <!-- App-local Settings page. It deliberately sits outside ProjectDocument
         and never affects canonical evidence or an export manifest. -->
    <Border Grid.Row="0"
            Grid.RowSpan="4"
            Grid.Column="1"
            Grid.ColumnSpan="5"
            Background="#F2081A22"
            IsVisible="{Binding IsSettingsPageOpen}">
      <Grid ColumnDefinitions="248,*">
        <Border Background="#0B222B" BorderBrush="{StaticResource PanelBorder}" BorderThickness="0,0,1,0">
          <StackPanel Margin="20" Spacing="9">
            <materialIcons:MaterialIcon Kind="CogOutline" Width="28" Height="28" Foreground="{StaticResource AccentTeal}" />
            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Settings" />
            <TextBlock Classes="muted" TextWrapping="Wrap" Text="These preferences stay on this computer and are never added to a RoadWatcher project." />
          </StackPanel>
        </Border>
        <Grid Grid.Column="1" RowDefinitions="54,*">
          <Grid Margin="20,0" ColumnDefinitions="*,Auto">
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock FontSize="14" FontWeight="SemiBold" Text="Application status &amp; preferences" />
              <TextBlock Classes="muted" FontSize="10" Text="Local configuration only" />
            </StackPanel>
            <Button Grid.Column="1" Classes="icon" VerticalAlignment="Center" Command="{Binding CloseSettingsCommand}" ToolTip.Tip="Close Settings">
              <materialIcons:MaterialIcon Kind="Close" Width="20" Height="20" />
            </Button>
          </Grid>
          <ScrollViewer Grid.Row="1" Margin="20,0,20,20">
            <StackPanel Spacing="16">
              <Border Classes="panel" Padding="14">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="160,*" RowSpacing="8">
                  <TextBlock FontWeight="SemiBold" Text="Status" />
                  <TextBlock Grid.Row="1" Classes="muted" Text="Version" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding AppVersionText}" />
                  <TextBlock Grid.Row="2" Classes="muted" Text="Project" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SettingsProjectState}" />
                  <TextBlock Grid.Row="3" Classes="muted" Text="VLC" />
                  <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SettingsVlcStatus}" />
                  <TextBlock Grid.Row="4" Classes="muted" Text="FFmpeg / Tesseract" />
                  <StackPanel Grid.Row="4" Grid.Column="1" Spacing="2">
                    <TextBlock Text="{Binding SettingsFfmpegStatus}" />
                    <TextBlock Classes="muted" FontSize="10" Text="{Binding SettingsTesseractStatus}" />
                  </StackPanel>
                </Grid>
              </Border>

              <Border Classes="panel" Padding="14">
                <StackPanel Spacing="10">
                  <TextBlock FontWeight="SemiBold" Text="Logging" />
                  <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto" RowSpacing="8">
                    <TextBlock VerticalAlignment="Center" Classes="muted" Text="Minimum level" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding SettingsLogLevels}" SelectedItem="{Binding SettingsLogLevel, Mode=TwoWay}" />
                    <TextBlock Grid.Row="1" VerticalAlignment="Top" Classes="muted" Text="Local rolling log" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="muted" FontFamily="Consolas" FontSize="10" TextWrapping="Wrap" Text="{Binding SettingsLogPath}" />
                  </Grid>
                  <TextBlock Classes="muted" FontSize="10" Text="Warning is the default. Fourteen daily files are retained; normal logs omit raw GPX and video content." TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Border Classes="panel" Padding="14">
                <StackPanel Spacing="10">
                  <TextBlock FontWeight="SemiBold" Text="FFmpeg" />
                  <CheckBox IsChecked="{Binding UseManualFfmpegPath, Mode=TwoWay}" Content="Use a manually selected executable" />
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Text="{Binding SettingsFfmpegPath, Mode=TwoWay}" IsEnabled="{Binding UseManualFfmpegPath}" Watermark="ffmpeg or full executable path" />
                    <Button Grid.Column="1" Command="{Binding TestFfmpegCommand}" Content="Test" />
                  </Grid>
                  <TextBlock Classes="muted" FontSize="10" Text="The configured path applies to newly submitted jobs after saving." />
                </StackPanel>
              </Border>

              <Border Classes="panel" Padding="14">
                <StackPanel Spacing="10">
                  <TextBlock FontWeight="SemiBold" Text="Map and caches" />
                  <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto" RowSpacing="8">
                    <TextBlock VerticalAlignment="Center" Classes="muted" Text="Preferred map style" />
                    <ComboBox Grid.Column="1" ItemsSource="{Binding SettingsMapStyles}" SelectedItem="{Binding SettingsMapStyle, Mode=TwoWay}" />
                    <TextBlock Grid.Row="1" VerticalAlignment="Top" Classes="muted" Text="Cache usage" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="muted" TextWrapping="Wrap" Text="{Binding SettingsCacheStatus}" />
                  </Grid>
                  <WrapPanel ItemWidth="136" ItemHeight="32">
                    <Button Margin="0,0,8,8" Command="{Binding ClearThumbnailCacheCommand}" Content="Clear thumbnails" />
                    <Button Margin="0,0,8,8" Command="{Binding ClearProxyCacheCommand}" Content="Clear proxies" />
                    <Button Margin="0,0,8,8" Command="{Binding ClearMapCacheCommand}" Content="Clear map tiles" />
                  </WrapPanel>
                </StackPanel>
              </Border>

              <Grid ColumnDefinitions="*,Auto">
                <TextBlock VerticalAlignment="Center" Classes="muted" FontSize="10" Text="Saving preferences does not modify the open evidence project." />
                <Button Grid.Column="1" Classes="primary" Command="{Binding SaveSettingsCommand}" Content="Save settings" />
              </Grid>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Grid>
    </Border>
  </Grid>
</Window>
