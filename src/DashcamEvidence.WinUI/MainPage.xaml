<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="DashcamEvidence_WinUI.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="20" RowSpacing="12" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <CommandBar Grid.Row="0" DefaultLabelPosition="Right" IsOpen="False">
            <AppBarButton Icon="OpenFile" Label="Import Recording" Click="ImportRecording_Click" />
            <AppBarButton Icon="MapDrive" Label="Import GPX" Click="ImportGpx_Click" />
            <AppBarSeparator />
            <AppBarButton Icon="OpenFile" Label="Load" Click="LoadManifest_Click" />
            <AppBarButton Icon="Save" Label="Save" Click="SaveManifest_Click" />
            <AppBarButton Icon="Share" Label="Export Selected" Click="ExportSelected_Click" />
        </CommandBar>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="420" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8" Background="Black">
                    <MediaPlayerElement x:Name="VideoPlayer" AreTransportControlsEnabled="True" AutoPlay="False" Stretch="Uniform" />
                </Border>

                <CommandBar Grid.Row="1" DefaultLabelPosition="Right" IsOpen="False">
                    <AppBarButton Label="Smart Inspect" Click="SmartInspect_Click" />
                    <AppBarButton Label="Scan Road" Click="ScanRoad_Click" />
                    <AppBarButton Label="Set Start" Click="MarkStart_Click" />
                    <AppBarButton Label="Set End" Click="MarkEnd_Click" />
                    <AppBarButton Label="Seek Selected" Click="SeekSelected_Click" />
                </CommandBar>

                <InfoBar Grid.Row="2" x:Name="RecordingInfo" IsOpen="True" Severity="Informational" Title="Ready" Message="Import a recording to begin review." />
            </Grid>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <TextBlock Text="Incident Inspector" Style="{ThemeResource TitleTextBlockStyle}" />

                    <ComboBox x:Name="CategoryBox" Header="Category" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="StartOffsetBox" Header="Start offset seconds" Text="0" />
                        <TextBox x:Name="EndOffsetBox" Grid.Column="1" Header="End offset seconds" Text="10" />
                    </Grid>

                    <TextBox x:Name="PlateBox" Header="Plate" />
                    <TextBox x:Name="VehicleBox" Header="Vehicle notes" />
                    <TextBox x:Name="AddressBox" Header="Address or location notes" />

                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="LatitudeBox" Header="Latitude" />
                        <TextBox x:Name="LongitudeBox" Grid.Column="1" Header="Longitude" />
                    </Grid>

                    <TextBox x:Name="NotesBox" Header="Notes" AcceptsReturn="True" Height="96" TextWrapping="Wrap" />

                    <Button Content="Add Incident" Click="AddIncident_Click" HorizontalAlignment="Stretch" />

                    <TextBlock Text="Detected vehicles" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <ListView x:Name="RoadScanList" MinHeight="120" SelectionChanged="RoadScanList_SelectionChanged" />

                    <TextBlock Text="Saved incidents" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <ListView x:Name="IncidentList" MinHeight="180" SelectionChanged="IncidentList_SelectionChanged" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <InfoBar Grid.Row="2" x:Name="StatusBar" IsOpen="True" Severity="Informational" Title="Status" Message="Checking local tools..." />
    </Grid>
</Page>
